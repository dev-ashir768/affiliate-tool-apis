+import { describe, it, expect } from "vitest";
+
+/**
+ * Gated live smoke against a running API.
+ * Skip unless SMOKE_HTTP=1 (requires Postgres + API on SMOKE_BASE_URL).
+ */
+const enabled = process.env.SMOKE_HTTP === "1";
