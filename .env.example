# affiliate-tool-apis — copy to .env and fill values.
# Optional vars (shop verify, bot inbox, TikTok, Meili, crawl, Sentry, SMTP, TTLs)
# have defaults in src/config/env.ts — only set them when you override.

NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://user:password@localhost:5432/affiliate_tool
REDIS_URL=redis://:password@localhost:6379/0

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
SESSION_VAULT_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Required in production (and recommended locally). Must match portal PORTAL_BFF_SECRET.
PORTAL_BFF_SECRET=change-me-portal-bff-secret-min-16

CORS_ORIGINS=http://localhost:3000
# Required in production — Stripe return URLs, invites, password reset.
# PORTAL_BASE_URL=https://portal.dealhoper.com
TRUST_PROXY=false

STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Must match Stripe Dashboard product/amount per plan (Starter/Growth/Pro).
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_GROWTH=price_xxx
STRIPE_PRICE_PRO=price_xxx

EMAIL_PROVIDER=console
EMAIL_FROM="Tiksly <noreply@localhost>"

# Seed-only platform superadmin (optional). Use a throwaway local email.
PLATFORM_SUPERADMIN_EMAIL=superadmin@localhost.local
PLATFORM_SUPERADMIN_PASSWORD=change-me-superadmin-password

# TikTok (set when connecting shops)
# TIKTOK_SHOP_APP_KEY=
# TIKTOK_SHOP_APP_SECRET=
# TIKTOK_SHOP_SERVICE_ID=
# TIKTOK_SHOP_REDIRECT_URI=http://localhost:3000/shops/tiktok/callback

# Production email
# EMAIL_PROVIDER=smtp
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=
