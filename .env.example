###############################################################################
# affiliate-tool-apis — environment
# Copy to .env and fill secrets. Validated by src/config/env.ts on boot.
# Sibling portal: https://github.com/dev-ashir768/affiliate-tool-portal
###############################################################################

NODE_ENV=development
PORT=4000

# ---------------------------------------------------------------------------
# Core (required)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/affiliate_tool
REDIS_URL=redis://:password@localhost:6379/0

# JWT / session vault — each secret must be ≥32 characters
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
SESSION_VAULT_KEY=0123456789abcdef0123456789abcdef
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=604800

# Comma-separated portal origins (first entry used for email / invite links)
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Stripe (optional locally; required for checkout + webhooks in prod)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Used by prisma/seed.ts for paid plan stripePriceId
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_GROWTH=price_xxx
STRIPE_PRICE_PRO=price_xxx
# Legacy alias still accepted by seed:
# STRIPE_PRICE_AGENCY=price_xxx
#
# Webhook (raw body): POST {API}/api/v1/webhooks/stripe
# Events: checkout.session.completed, customer.subscription.*, invoice.paid,
#         invoice.payment_failed
# Local: stripe listen --forward-to localhost:4000/api/v1/webhooks/stripe

# ---------------------------------------------------------------------------
# Email — console (dev log) | smtp | resend
# Transactional: welcome, billing notices, invites, password reset, staff
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=console
EMAIL_FROM="Tiksly <noreply@localhost>"
# EMAIL_LOGO_URL=https://app.yourdomain.com/images/brandings/logo.png
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# RESEND_API_KEY=
# Production outreach/billing email needs smtp|resend + verified EMAIL_FROM.

# ---------------------------------------------------------------------------
# Shop verify (stub | playwright)
# ---------------------------------------------------------------------------
SHOP_VERIFY_MODE=stub
PLAYWRIGHT_SHOP_VERIFY_DRY_RUN=true
# SHOP_VERIFY_FIXTURE_URL=
SHOP_VERIFY_TARGET=fixture
# SHOP_VERIFY_LIVE_URL_US=https://seller-us.tiktok.com/...
# SHOP_VERIFY_LIVE_URL_UK=https://seller-uk.tiktok.com/...
# SHOP_VERIFY_LIVE_ACCEPT_SELECTOR=[data-e2e='invite-accept'], button:has-text('Accept')
# SHOP_VERIFY_LIVE_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# Bot inbox — none | console | imap
# ---------------------------------------------------------------------------
BOT_INBOX_PROVIDER=none
BOT_INBOX_POLL_MS=5000
BOT_INBOX_TIMEOUT_MS=120000
BOT_INBOX_SUBJECT_INCLUDES=invite
# IMAP_HOST=imap.example.com
# IMAP_PORT=993
# IMAP_USER=
# IMAP_PASS=
# IMAP_TLS=true

# ---------------------------------------------------------------------------
# Auth TTLs + platform seed superadmin
# ---------------------------------------------------------------------------
PASSWORD_RESET_TTL_SEC=3600
INVITE_TTL_SEC=604800
PLATFORM_SUPERADMIN_EMAIL=superadmin@platform.local
PLATFORM_SUPERADMIN_PASSWORD=SuperAdmin123!
# PLATFORM_SUPERADMIN_PASSWORD_HASH=

# ---------------------------------------------------------------------------
# Optional observability
# ---------------------------------------------------------------------------
# SENTRY_DSN=

# ---------------------------------------------------------------------------
# TikTok Shop OpenAPI (Partner Center)
# ---------------------------------------------------------------------------
# TIKTOK_SHOP_APP_KEY=
# TIKTOK_SHOP_APP_SECRET=
# TIKTOK_SHOP_SERVICE_ID=
# Must match Partner Center redirect URI (portal callback page)
# TIKTOK_SHOP_REDIRECT_URI=http://localhost:3000/shops/tiktok/callback
# Optional platform fallback tokens (prefer per-shop OAuth)
# TIKTOK_SHOP_ACCESS_TOKEN=
# TIKTOK_SHOP_REFRESH_TOKEN=
# TIKTOK_SHOP_CIPHER=
TIKTOK_SHOP_OPENAPI_BASE_URL=https://open-api.tiktokglobalshop.com
TIKTOK_SHOP_REGION=US
TIKTOK_SHOP_AUTHORIZE_URL_US=https://services.us.tiktokshop.com/open/authorize
TIKTOK_SHOP_AUTHORIZE_URL_UK=https://services.tiktokshop.com/open/authorize
TIKTOK_SHOP_TOKEN_URL=https://auth.tiktok-shops.com/api/v2/token/get
TIKTOK_SHOP_REFRESH_URL=https://auth.tiktok-shops.com/api/v2/token/refresh

# ---------------------------------------------------------------------------
# Meilisearch (optional — discovery falls back to Postgres)
# ---------------------------------------------------------------------------
# MEILI_HOST=http://127.0.0.1:7700
# MEILI_API_KEY=
# MEILI_INDEX_DISCOVERY=discovery_creators

# ---------------------------------------------------------------------------
# Discovery crawl scheduler (worker BullMQ repeatable jobs)
# ---------------------------------------------------------------------------
DISCOVERY_CRAWL_SCHEDULER_ENABLED=false
DISCOVERY_CRAWL_CRON=0 */6 * * *
DISCOVERY_CRAWL_MAX_CELLS=200
DISCOVERY_CRAWL_SKIP_DAYS=7
DISCOVERY_CRAWL_MAX_PAGES=10
# DISCOVERY_CRAWL_US_ORGANIZATION_ID=
# DISCOVERY_CRAWL_US_SHOP_ID=
# DISCOVERY_CRAWL_UK_ORGANIZATION_ID=
# DISCOVERY_CRAWL_UK_SHOP_ID=
