NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://user:password@localhost:5432/affiliate_tool
REDIS_URL=redis://:password@your-vps-host:6379
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
SESSION_VAULT_KEY=0123456789abcdef0123456789abcdef
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=604800
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Price IDs from Stripe Dashboard — used by `prisma/seed.ts` for paid plans
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_GROWTH=price_xxx
STRIPE_PRICE_AGENCY=price_xxx

# Email — React Email templates + nodemailer SMTP
# console = log only (dev); smtp = real delivery
EMAIL_PROVIDER=smtp
EMAIL_FROM="influxa <noreply@yourdomain.com>"
# Optional override; default = {CORS_ORIGINS[0]}/images/brandings/logo.png
# EMAIL_LOGO_URL=https://app.yourdomain.com/images/brandings/logo.png
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

SHOP_VERIFY_MODE=stub
# When SHOP_VERIFY_MODE=playwright, dry-run activates without Chromium (default true)
PLAYWRIGHT_SHOP_VERIFY_DRY_RUN=true
PASSWORD_RESET_TTL_SEC=3600
INVITE_TTL_SEC=604800
# Optional: bootstrap platform superadmin on seed (Task 2)
PLATFORM_SUPERADMIN_EMAIL=
PLATFORM_SUPERADMIN_PASSWORD=
# Optional: precomputed argon2id hash when native argon2 is unavailable locally
PLATFORM_SUPERADMIN_PASSWORD_HASH=
