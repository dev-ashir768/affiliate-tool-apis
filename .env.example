NODE_ENV=development
PORT=4000

# Postgres + Redis (required)
DATABASE_URL=postgresql://user:password@localhost:5432/affiliate_tool
REDIS_URL=redis://:password@localhost:6379/0

# JWT / session (each secret must be ≥32 characters)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
SESSION_VAULT_KEY=0123456789abcdef0123456789abcdef
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=604800

CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false

# Stripe (optional in local; required for checkout)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Price IDs from Stripe Dashboard — used by prisma/seed.ts for paid plans
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_GROWTH=price_xxx
STRIPE_PRICE_AGENCY=price_xxx

# Email — console | smtp | resend
EMAIL_PROVIDER=console
EMAIL_FROM="Tiksly <noreply@localhost>"
# EMAIL_LOGO_URL=https://app.yourdomain.com/images/brandings/logo.png
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# RESEND_API_KEY=

# Shop verify: stub | playwright
SHOP_VERIFY_MODE=stub
PLAYWRIGHT_SHOP_VERIFY_DRY_RUN=true
# SHOP_VERIFY_FIXTURE_URL=
SHOP_VERIFY_TARGET=fixture
# SHOP_VERIFY_LIVE_URL_US=https://seller-us.tiktok.com/...
# SHOP_VERIFY_LIVE_URL_UK=https://seller-uk.tiktok.com/...
# SHOP_VERIFY_LIVE_ACCEPT_SELECTOR=[data-e2e='invite-accept']
# SHOP_VERIFY_LIVE_TIMEOUT_MS=60000
# FORCE_SHOP_VERIFY_ENQUEUE=false

# Bot inbox: none | console | imap
BOT_INBOX_PROVIDER=none
# BOT_INBOX_SUBJECT_INCLUDES=invite
# BOT_INBOX_POLL_MS=5000
# BOT_INBOX_TIMEOUT_MS=120000
# IMAP_HOST=imap.example.com
# IMAP_PORT=993
# IMAP_USER=
# IMAP_PASS=
# IMAP_TLS=true

# Optional error tracking
# SENTRY_DSN=

PASSWORD_RESET_TTL_SEC=3600
INVITE_TTL_SEC=604800

# Optional: bootstrap platform superadmin on seed
PLATFORM_SUPERADMIN_EMAIL=superadmin@platform.local
PLATFORM_SUPERADMIN_PASSWORD=SuperAdmin123!
# PLATFORM_SUPERADMIN_PASSWORD_HASH=
