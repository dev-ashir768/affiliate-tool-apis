{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Tiksly Affiliate Tool APIs — Foundation",
    "description": "Foundation API: auth, orgs/invites, Stripe billing, shop connect + verify.\n\n**Setup**\n1. Import this collection and `postman/Tiksly-Foundation.environment.json`.\n2. Set `baseUrl` (default `http://localhost:4000`).\n3. Run **Auth → Register** or **Login** — scripts save `accessToken` and `refreshToken`.\n4. Bearer auth is applied from `{{accessToken}}` on protected routes.\n\n**Notes**\n- Free plan has `shopLimit: 0`. Bump org shopLimit (DB/billing) before Connect Shop.\n- Shop verify needs API + worker (`npm run worker`) and reachable Redis.\n- Stripe webhook expects raw body + `Stripe-Signature` (use Stripe CLI).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "shopId", "value": "" },
    { "key": "inviteToken", "value": "" },
    { "key": "planCode", "value": "starter" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET Health",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "Liveness check. Returns `{ ok: true }`."
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const j = pm.response.json();",
                  "  if (j.accessToken) pm.collectionVariables.set('accessToken', j.accessToken);",
                  "  if (j.refreshToken) pm.collectionVariables.set('refreshToken', j.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"owner_{{$timestamp}}@example.com\",\n  \"password\": \"Secret123!\",\n  \"name\": \"Ashir\",\n  \"organizationName\": \"Tiksly Demo\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/register",
            "description": "Creates user + org + OWNER membership. Saves tokens to collection vars."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  if (j.accessToken) pm.collectionVariables.set('accessToken', j.accessToken);",
                  "  if (j.refreshToken) pm.collectionVariables.set('refreshToken', j.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"owner@example.com\",\n  \"password\": \"Secret123!\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login",
            "description": "Login. Saves access + refresh tokens."
          }
        },
        {
          "name": "Refresh",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  if (j.accessToken) pm.collectionVariables.set('accessToken', j.accessToken);",
                  "  if (j.refreshToken) pm.collectionVariables.set('refreshToken', j.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/refresh",
            "description": "Rotate refresh (body). Cookie also supported if sent by client."
          }
        },
        {
          "name": "Logout",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/logout",
            "description": "Revoke refresh. Expect 204."
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/me",
            "description": "Current user + memberships. Requires Bearer access token."
          }
        }
      ]
    },
    {
      "name": "Orgs",
      "item": [
        {
          "name": "Get Current Org",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/orgs/current",
            "description": "Org + plan + subscription summary."
          }
        },
        {
          "name": "Patch Current Org",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tiksly Demo Updated\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/orgs/current",
            "description": "OWNER/ADMIN only."
          }
        },
        {
          "name": "List Members",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/orgs/current/members"
          }
        },
        {
          "name": "Create Invite",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const j = pm.response.json();",
                  "  if (j.inviteToken) pm.collectionVariables.set('inviteToken', j.inviteToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"va_{{$timestamp}}@example.com\",\n  \"role\": \"MEMBER\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/orgs/current/invites",
            "description": "OWNER/ADMIN. Seat-limited. Response includes one-time invite token (saved to `inviteToken` if present)."
          }
        },
        {
          "name": "Accept Invite (stub — password + name)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"Secret123!\",\n  \"name\": \"Virtual Assistant\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/orgs/invites/{{inviteToken}}/accept",
            "description": "For invite stub users. Real existing users must send Bearer auth instead."
          }
        }
      ]
    },
    {
      "name": "Billing",
      "item": [
        {
          "name": "List Plans",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/billing/plans"
          }
        },
        {
          "name": "Create Checkout Session",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"planCode\": \"{{planCode}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/billing/checkout-session",
            "description": "OWNER/ADMIN. Requires Stripe keys + plan.stripePriceId. Returns Checkout URL."
          }
        },
        {
          "name": "Create Portal Session",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/billing/portal-session",
            "description": "OWNER/ADMIN. Requires existing stripeCustomerId on org."
          }
        },
        {
          "name": "Stripe Webhook (manual — prefer Stripe CLI)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Stripe-Signature", "value": "t=...,v1=... (from Stripe CLI)" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"evt_test\",\n  \"type\": \"customer.subscription.updated\",\n  \"data\": {}\n}"
            },
            "url": "{{baseUrl}}/api/v1/webhooks/stripe",
            "description": "Prefer: `stripe listen --forward-to localhost:4000/api/v1/webhooks/stripe`. Postman rarely signs correctly."
          }
        }
      ]
    },
    {
      "name": "Shops",
      "item": [
        {
          "name": "List Shops",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/shops"
          }
        },
        {
          "name": "Connect Shop",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const j = pm.response.json();",
                  "  if (j.id) pm.collectionVariables.set('shopId', j.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"region\": \"US\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/shops/connect",
            "description": "OWNER/ADMIN. Allocates bot email. Requires shopLimit > 0. Saves `shopId`."
          }
        },
        {
          "name": "Get Shop",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/shops/{{shopId}}"
          }
        },
        {
          "name": "Verify Shop",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/shops/{{shopId}}/verify",
            "description": "OWNER/ADMIN. Enqueues BullMQ stub verify. Poll Get Shop until ACTIVE."
          }
        },
        {
          "name": "Disconnect Shop",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/v1/shops/{{shopId}}",
            "description": "OWNER/ADMIN. Releases bot."
          }
        }
      ]
    }
  ]
}
