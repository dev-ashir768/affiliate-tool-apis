// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum BillingLifecycleType {
  REGISTERED
  SUBSCRIBED
  RENEWED
  UPGRADED
  DOWNGRADED
  CANCELED
}

enum BotStatus {
  AVAILABLE
  RESERVED
  ASSIGNED
  DISABLED
}

enum ShopRegion {
  US
  UK
}

enum ShopStatus {
  PENDING_INVITE
  VERIFYING
  ACTIVE
  FAILED
  DISCONNECTED
}

enum ShopVerifyMode {
  STUB
  PLAYWRIGHT
}

enum VerificationJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum PlatformRole {
  SUPERADMIN
  FINANCE
  OPS
}

enum PlatformMembershipStatus {
  ACTIVE
  DISABLED
}

enum NavArea {
  DASHBOARD
  BACKOFFICE
}

enum ProxyStatus {
  AVAILABLE
  IN_USE
  DISABLED
  BANNED
}

enum ProxyProtocol {
  HTTP
  HTTPS
  SOCKS5
}

enum CreatorPlatform {
  TIKTOK
}

enum CreatorStage {
  LEAD
  CONTACTED
  INVITED
  ACTIVE
  REJECTED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  DONE
}

enum OutreachStatus {
  DRAFT
  QUEUED
  SENT
  FAILED
}

enum AffiliateInviteStatus {
  DRAFT
  QUEUED
  SENT
  PARTIAL
  FAILED
}

enum AffiliateInviteRecipientStatus {
  PENDING
  INVITED
  CONFLICT
  SKIPPED
  FAILED
}

enum AutomationRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  CANCELED
}

enum AutomationStepKind {
  EMAIL
  AFFILIATE_INVITE
  CREATOR_IM
}

enum AutomationStepStatus {
  PENDING
  RUNNING
  DONE
  SKIPPED
  FAILED
}

enum ImMessageDirection {
  INBOUND
  OUTBOUND
  SYSTEM
}

enum ImMessageStatus {
  RECEIVED
  SENT
  FAILED
}

enum OrderStatus {
  PENDING
  PAID
  REFUNDED
  CANCELED
}

enum SampleRequestStatus {
  PENDING
  APPROVED
  REJECTED
  FULFILLING
  FULFILLED
  FAILED
  CANCELED
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  name         String
  status       UserStatus     @default(ACTIVE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  memberships         Membership[]
  refreshTokens       RefreshToken[]
  platformMembership  PlatformMembership?
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]           @relation("AuditActor")
}

model Plan {
  id                String   @id @default(cuid())
  code              String   @unique // free | starter | growth | pro
  name              String
  description       String?
  monthlyPriceCents Int
  seatLimit         Int
  shopLimit         Int
  /// Max reserved bots (shop verify identities) for the org.
  botLimit          Int      @default(0)
  dailyInviteQuota  Int
  /// Stripe Checkout trial length (0 = no trial).
  trialDays         Int      @default(0)
  stripePriceId     String?
  /// Shown on billing / onboarding when true.
  isPublic          Boolean  @default(true)
  /// Ops can soft-disable a plan without deleting history.
  active            Boolean  @default(true)
  sortOrder         Int      @default(0)
  organizations     Organization[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Organization {
  id               String         @id @default(cuid())
  name             String
  slug             String         @unique
  planId           String
  plan             Plan           @relation(fields: [planId], references: [id])
  stripeCustomerId String?
  seatLimit        Int
  shopLimit        Int
  botLimit         Int            @default(0)
  dailyInviteQuota Int
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  memberships      Membership[]
  subscription     Subscription?
  shops            Shop[]
  creators         Creator[]
  creatorLists     CreatorList[]
  campaigns        Campaign[]
  outreachTemplates OutreachTemplate[]
  outreachMessages  OutreachMessage[]
  affiliateInvites  AffiliateInvite[]
  automationRuns    AutomationRun[]
  creatorConversations CreatorConversation[]
  shopOrders       ShopOrder[]
  commissions      Commission[]
  sampleRequests   SampleRequest[]
  billingLifecycleEvents BillingLifecycleEvent[]
}

model Membership {
  id              String           @id @default(cuid())
  userId          String
  organizationId  String
  role            MembershipRole
  status          MembershipStatus @default(ACTIVE)
  inviteTokenHash String?
  inviteExpiresAt DateTime?
  user            User             @relation(fields: [userId], references: [id])
  organization    Organization     @relation(fields: [organizationId], references: [id])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([userId, organizationId])
  @@index([inviteTokenHash])
}

model Subscription {
  id                   String             @id @default(cuid())
  organizationId       String             @unique
  organization         Organization       @relation(fields: [organizationId], references: [id])
  stripeSubscriptionId String             @unique
  status               SubscriptionStatus
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model RefreshToken {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  replacedById String?
  createdAt   DateTime  @default(now())
}

model BotIdentity {
  id              String    @id @default(cuid())
  email           String    @unique
  proxyBinding    String?
  status          BotStatus @default(AVAILABLE)
  reservedForOrgId String?
  reservedAt      DateTime?
  shop            Shop?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Shop {
  id                     String       @id @default(cuid())
  organizationId         String
  organization           Organization @relation(fields: [organizationId], references: [id])
  region                 ShopRegion
  botIdentityId          String?      @unique
  botIdentity            BotIdentity? @relation(fields: [botIdentityId], references: [id])
  externalShopId         String?
  displayName            String?
  status                 ShopStatus   @default(PENDING_INVITE)
  statusReason           String?
  sessionVaultCiphertext String?
  verifiedAt             DateTime?
  /// Seller OpenAPI OAuth (per-merchant). Tokens encrypted with SESSION_VAULT_KEY.
  tiktokOpenId           String?
  tiktokAccessTokenEnc   String?
  tiktokRefreshTokenEnc  String?
  tiktokShopCipherEnc    String?
  tiktokAccessExpiresAt  DateTime?
  tiktokRefreshExpiresAt DateTime?
  tiktokGrantedScopes    String[]     @default([])
  oauthConnectedAt       DateTime?
  verificationJobs       ShopVerificationJob[]
  shopOrders             ShopOrder[]
  affiliateInvites       AffiliateInvite[]
  automationRuns         AutomationRun[]
  creatorConversations   CreatorConversation[]
  sampleRequests         SampleRequest[]
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@index([organizationId])
}

model ShopVerificationJob {
  id        String                @id @default(cuid())
  shopId    String
  shop      Shop                  @relation(fields: [shopId], references: [id])
  bullJobId String?
  mode      ShopVerifyMode
  status    VerificationJobStatus @default(QUEUED)
  attempts  Int                   @default(0)
  lastError String?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
}

model StripeEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique
  type        String
  processedAt DateTime @default(now())
}

/// SaaS funnel / check-and-balance: register → subscribe → renew → upgrade/downgrade → cancel.
model BillingLifecycleEvent {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           BillingLifecycleType
  fromPlanCode   String?
  toPlanCode     String?
  actorUserId    String?
  stripeEventId  String?
  meta           Json?
  createdAt      DateTime             @default(now())

  @@index([organizationId, createdAt])
  @@index([type, createdAt])
  @@index([createdAt])
}

model PlatformMembership {
  id        String                   @id @default(cuid())
  userId    String                   @unique
  user      User                     @relation(fields: [userId], references: [id])
  role      PlatformRole
  status    PlatformMembershipStatus @default(ACTIVE)
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorUserId String?
  actor      User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}

model NavSection {
  id        String    @id @default(cuid())
  area      NavArea
  key       String
  label     String?
  sortOrder Int       @default(0)
  items     NavItem[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([area, key])
}

model NavItem {
  id                   String           @id @default(cuid())
  sectionId            String
  section              NavSection       @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  key                  String
  label                String
  href                 String
  icon                 String
  sortOrder            Int              @default(0)
  badge                String?
  enabled              Boolean          @default(true)
  allowedPlatformRoles PlatformRole[]
  allowedOrgRoles      MembershipRole[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@unique([sectionId, key])
}

model Proxy {
  id           String        @id @default(cuid())
  label        String
  host         String
  port         Int
  protocol     ProxyProtocol @default(HTTP)
  username     String?
  /// AES vault ciphertext for proxy password (never return plaintext)
  passwordEnc  String?
  region       String?
  status       ProxyStatus   @default(AVAILABLE)
  lastCheckedAt DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status])
  @@index([region])
  @@unique([host, port, protocol])
}

model Creator {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  platform       CreatorPlatform @default(TIKTOK)
  handle         String
  displayName    String?
  /// TikTok creator open_id from marketplace search (required for affiliate invites).
  creatorOpenId  String?
  /// TikTok IM user id (from conversation APIs).
  creatorImId    String?
  contactEmail   String?
  region         ShopRegion?
  followerCount  Int?
  avatarUrl      String?
  /// Marketplace affiliate GMV snapshot from TikTok (not shop order GMV).
  gmvAmount      String?
  gmvCurrency    String?
  gmvRange       String?
  videoGmvAmount String?
  liveGmvAmount  String?
  productCardGmvAmount String?
  avgCommissionRange String?
  unitsSold      Int?
  gpmAmount      String?
  gpmCurrency    String?
  gpmRange       String?
  /// Raw TikTok marketplace creator payload (forward-compatible).
  metricsRaw     Json?
  /// Last time marketplace metrics were refreshed from TikTok.
  metricsSyncedAt DateTime?
  notes          String?
  stage          CreatorStage    @default(LEAD)
  listMembers    CreatorListMember[]
  outreachMessages OutreachMessage[]
  affiliateInviteRecipients AffiliateInviteRecipient[]
  conversations  CreatorConversation[]
  shopOrders     ShopOrder[]
  commissions    Commission[]
  sampleRequests SampleRequest[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([organizationId, platform, handle])
  @@index([organizationId])
  @@index([stage])
  @@index([creatorOpenId])
  @@index([creatorImId])
  @@index([followerCount])
  @@index([metricsSyncedAt])
}

model CreatorList {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  members        CreatorListMember[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
}

model CreatorListMember {
  id        String      @id @default(cuid())
  listId    String
  list      CreatorList @relation(fields: [listId], references: [id], onDelete: Cascade)
  creatorId String
  creator   Creator     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([listId, creatorId])
  @@index([creatorId])
}

model Campaign {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  status         CampaignStatus @default(DRAFT)
  brief          String?
  offerNote      String?
  deadline       DateTime?
  outreachMessages OutreachMessage[]
  affiliateInvites AffiliateInvite[]
  automationRuns   AutomationRun[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([organizationId])
  @@index([status])
}

/// TikTok Shop target collaboration (private affiliate invite) for a shop.
model AffiliateInvite {
  id                        String                 @id @default(cuid())
  organizationId            String
  organization              Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shopId                    String
  shop                      Shop                   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  campaignId                String?
  campaign                  Campaign?              @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  name                      String
  message                   String?
  endAt                     DateTime
  sellerContactEmail        String?
  hasFreeSample             Boolean                @default(false)
  sampleApprovalExempt      Boolean                @default(false)
  /// [{ id, targetCommissionRate }] — rate in TikTok units (hundredths of a percent; 1000 = 10%).
  products                  Json
  externalCollaborationId   String?
  status                    AffiliateInviteStatus  @default(DRAFT)
  lastError                 String?
  conflicts                 Json?
  sentAt                    DateTime?
  recipients                AffiliateInviteRecipient[]
  sampleRequests            SampleRequest[]
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt

  @@index([organizationId])
  @@index([shopId])
  @@index([campaignId])
  @@index([status])
  @@index([createdAt])
}

model AffiliateInviteRecipient {
  id             String                         @id @default(cuid())
  inviteId       String
  invite         AffiliateInvite                @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  creatorId      String
  creator        Creator                        @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  creatorOpenId  String
  status         AffiliateInviteRecipientStatus @default(PENDING)
  lastError      String?
  createdAt      DateTime                       @default(now())
  updatedAt      DateTime                       @updatedAt

  @@unique([inviteId, creatorId])
  @@index([creatorId])
  @@index([status])
}

/// Multi-step outreach automation (email → TikTok invite) executed by BullMQ workers.
model AutomationRun {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaignId     String?
  campaign       Campaign?           @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  shopId         String?
  shop           Shop?               @relation(fields: [shopId], references: [id], onDelete: SetNull)
  name           String
  status         AutomationRunStatus @default(QUEUED)
  /// Snapshot of creator ids targeted by this run.
  creatorIds     String[]
  lastError      String?
  startedAt      DateTime?
  completedAt    DateTime?
  steps          AutomationRunStep[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([organizationId])
  @@index([campaignId])
  @@index([shopId])
  @@index([status])
  @@index([createdAt])
}

model AutomationRunStep {
  id           String                @id @default(cuid())
  runId        String
  run          AutomationRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  stepIndex    Int
  kind         AutomationStepKind
  status       AutomationStepStatus  @default(PENDING)
  delayMinutes Int                   @default(0)
  /// Step config snapshot (templateId / invite products / etc).
  config       Json
  result       Json?
  lastError    String?
  scheduledAt  DateTime?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@unique([runId, stepIndex])
  @@index([status])
}

/// Cached TikTok Shop ↔ creator IM conversation (affiliate seller messaging).
model CreatorConversation {
  id                      String               @id @default(cuid())
  organizationId          String
  organization            Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shopId                  String
  shop                    Shop                 @relation(fields: [shopId], references: [id], onDelete: Cascade)
  creatorId               String?
  creator                 Creator?             @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  externalConversationId  String
  creatorImId             String?
  creatorUsername         String?
  avatarUrl               String?
  unreadCount             Int                  @default(0)
  lastMessagePreview      String?
  lastMessageAt           DateTime?
  lastSyncedAt            DateTime?
  messages                CreatorImMessage[]
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  @@unique([shopId, externalConversationId])
  @@index([organizationId])
  @@index([creatorId])
  @@index([creatorImId])
  @@index([updatedAt])
}

model CreatorImMessage {
  id                 String             @id @default(cuid())
  conversationId     String
  conversation       CreatorConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  externalMessageId  String?
  direction          ImMessageDirection
  msgType            String             @default("TEXT")
  contentText        String?
  contentRaw         String?
  senderImId         String?
  status             ImMessageStatus    @default(RECEIVED)
  lastError          String?
  sentAt             DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([conversationId])
  @@index([externalMessageId])
  @@index([sentAt])
}

model OutreachTemplate {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  subject        String
  bodyText       String
  messages       OutreachMessage[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
}

model OutreachMessage {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  templateId     String?
  template       OutreachTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  campaignId     String?
  campaign       Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  creatorId      String
  creator        Creator          @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  toEmail        String?
  subject        String
  bodyText       String
  status         OutreachStatus   @default(DRAFT)
  lastError      String?
  sentAt         DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organizationId])
  @@index([creatorId])
  @@index([campaignId])
  @@index([status])
}

/// Platform-wide creator marketplace index. Re-sync overwrites metrics (followers/GMV).
model CreatorDiscoveryProfile {
  id            String          @id @default(cuid())
  platform      CreatorPlatform @default(TIKTOK)
  handle        String
  displayName   String?
  /// TikTok creator open_id — required to send target collaboration invites.
  creatorOpenId String?
  region        ShopRegion?
  followerCount Int?
  avatarUrl     String?
  /// Marketplace affiliate GMV snapshot (string amount as returned by TikTok).
  gmvAmount     String?
  gmvCurrency   String?
  gmvRange      String?
  /// Parsed major-unit GMV → integer cents (null when range-only / unparsable).
  gmvCents      Int?
  videoGmvAmount String?
  liveGmvAmount  String?
  productCardGmvAmount String?
  avgCommissionRange String?
  unitsSold     Int?
  gpmAmount     String?
  gpmCurrency   String?
  gpmRange      String?
  /// Opt-in contact email when TikTok returns it.
  contactEmail  String?
  /// Raw TikTok marketplace creator payload (forward-compatible).
  metricsRaw    Json?
  categories    String[]
  bio           String?
  source        String          @default("manual")
  enabled       Boolean         @default(true)
  /// Last TikTok marketplace metrics refresh.
  metricsSyncedAt DateTime?
  /// Last time a crawl cell upserted this row (may equal metricsSyncedAt).
  lastCrawledAt DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([platform, handle])
  @@index([region])
  @@index([followerCount])
  @@index([enabled])
  @@index([creatorOpenId])
  @@index([metricsSyncedAt])
  @@index([source])
  @@index([enabled, region, followerCount])
  @@index([enabled, unitsSold])
  @@index([enabled, gmvCents])
}

/// Tracks crawl-grid cells (keyword × region × follower band) for planner skip / ops.
model DiscoveryCrawlCell {
  id           String     @id @default(cuid())
  cellKey      String     @unique
  region       ShopRegion
  keyword      String
  minFollowers Int?
  lastRunAt    DateTime?
  lastStatus   String?
  lastImported Int        @default(0)
  lastUpdated  Int        @default(0)
  lastError    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([region])
  @@index([lastRunAt])
  @@index([lastStatus])
}

/// Editable crawl keyword grid terms (ops CRUD). region null = applies to all regions.
model DiscoveryCrawlTerm {
  id        String      @id @default(cuid())
  keyword   String
  /// null = all regions; otherwise US or UK only.
  region    ShopRegion?
  /// Denormalized unique key: ALL | US | UK (Postgres unique treats NULL as distinct).
  regionKey String      @default("ALL")
  enabled   Boolean     @default(true)
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([keyword, regionKey])
  @@index([enabled, sortOrder])
  @@index([region])
}

model ShopOrder {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shopId          String?
  shop            Shop?        @relation(fields: [shopId], references: [id], onDelete: SetNull)
  creatorId       String?
  creator         Creator?     @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  externalOrderId String
  gmvCents        Int
  currency        String       @default("USD")
  status          OrderStatus  @default(PENDING)
  orderedAt       DateTime
  commissions     Commission[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([organizationId, externalOrderId])
  @@index([organizationId])
  @@index([creatorId])
  @@index([orderedAt])
  @@index([status])
}

model Commission {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orderId        String
  order          ShopOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  creatorId      String?
  creator        Creator?         @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  amountCents    Int
  status         CommissionStatus @default(PENDING)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organizationId])
  @@index([orderId])
  @@index([creatorId])
  @@index([status])
}

/// TikTok Shop free-sample application tracked in CRM (approve / reject / fulfill).
model SampleRequest {
  id                    String              @id @default(cuid())
  organizationId        String
  organization          Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shopId                String
  shop                  Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  creatorId             String?
  creator               Creator?            @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  affiliateInviteId     String?
  affiliateInvite       AffiliateInvite?    @relation(fields: [affiliateInviteId], references: [id], onDelete: SetNull)
  externalApplicationId String?
  externalProductId     String?
  productTitle          String?
  creatorUsername       String?
  creatorOpenId         String?
  status                SampleRequestStatus @default(PENDING)
  reviewNote            String?
  lastError             String?
  products              Json?
  fulfillmentRaw        Json?
  metricsRaw            Json?
  requestedAt           DateTime?
  reviewedAt            DateTime?
  fulfilledAt           DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([organizationId, externalApplicationId])
  @@index([organizationId, status])
  @@index([shopId])
  @@index([creatorId])
  @@index([affiliateInviteId])
  @@index([requestedAt])
}
